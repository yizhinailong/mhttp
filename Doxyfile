# Project
PROJECT_NAME           = mhttp
PROJECT_BRIEF          = "基于 standalone Asio 的异步 HTTP 库"
OUTPUT_DIRECTORY       = target/doxygen
OUTPUT_LANGUAGE        = Chinese
INPUT_ENCODING         = UTF-8
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

# Document the project pages and C++ module interfaces.
INPUT                  = README.md AGENTS.md docs src
FILE_PATTERNS          = *.cppm *.cpp *.hpp *.h *.md *.dox
EXTENSION_MAPPING      = cppm=C++
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE  = README.md
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
SOURCE_BROWSER         = YES

# Generate a self-contained HTML site without LaTeX or Graphviz.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO

# Surface documentation errors locally and in CI.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
