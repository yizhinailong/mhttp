    /**
     * @brief Look up the MIME type of a file extension.
     * @param extension Extension including the dot, e.g. ".html"; matched case-insensitively.
     * @return MIME type, or "application/octet-stream" when unknown.
     */
    auto get_mime_type(std::string_view extension) -> std::string_view {
        std::string lower{ extension };
        std::ranges::transform(lower, lower.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
        auto const it{ std::ranges::lower_bound(MIME_TABLE, std::string_view{ lower }, {}, &std::pair<std::string_view, std::string_view>::first) };
        if (it == MIME_TABLE.end() || it->first != lower) {
            return "application/octet-stream";
        }
        return it->second;
    }

} // namespace mhttp::detail
